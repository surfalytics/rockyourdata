---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import InteractionCard from "../components/InteractionCard.astro";
import OfferCard from "../components/OfferCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PlatformLogos from "../components/PlatformLogos.astro";
import SwagSection from "../components/SwagSection.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import { featuredServices, interactionModes } from "../data/services";
import { offers } from "../data/offers";
import { projects } from "../data/projects";

const homeProjects = projects.slice(0, 3);
---

<MarketingLayout>
  <Hero />

  <!-- Platform credibility strip -->
  <PlatformLogos class="!pt-10 md:!pt-12" />

  <!-- About band -->
  <section class="shell pt-20 md:pt-28">
    <div class="grid gap-8 border-t border-line pt-12 md:grid-cols-[0.9fr_1.1fr] md:gap-16">
      <div>
        <span class="eyebrow">Databricks · Snowflake · AI</span>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-navy md:text-4xl">
          Your data. Our skills.
        </h2>
      </div>
      <div class="text-lg leading-relaxed text-ink-soft">
        <p>
          Rock Your Data is a data consulting firm. We design and build cloud
          data platforms on Databricks and Snowflake, engineer the AI-ready data
          layer behind generative-AI products, and grow the teams that own them.
        </p>
        <p class="mt-4">
          We are vendor-neutral by design. We work across Databricks, Snowflake,
          dbt, AWS, Azure, and Google Cloud, so the recommendation you get is the
          one that fits your workloads — not the one we happen to resell.
        </p>
        <a
          href="/about/"
          class="mt-6 inline-flex items-center gap-2 font-semibold text-periwinkle hover:text-navy"
        >
          Learn more about us
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="shell scroll-mt-24 pt-20 md:pt-28">
    <SectionHeading eyebrow="What we do" title="Our services" />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {featuredServices.map((service) => <ServiceCard service={service} />)}
    </div>
    <div class="mt-10 text-center">
      <a href="/services/" class="btn-outline text-base">
        View all services
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>

  <!-- Fixed-scope entry offers -->
  <section class="shell pt-20 md:pt-28">
    <SectionHeading
      eyebrow="Start small"
      title="Fixed-scope assessments"
      subtitle="Not ready for a full build? Start with a short, fixed-scope engagement. You walk away with a plan you can act on — with us or without us."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {offers.map((offer) => <OfferCard offer={offer} />)}
    </div>
  </section>

  <!-- Proof -->
  <section class="shell pt-20 md:pt-28">
    <SectionHeading
      eyebrow="Proof"
      title="Selected projects"
      subtitle="Platforms we have built at Amazon, Microsoft, and across North American SaaS, telecom and fintech — team setup, architecture and all."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {homeProjects.map((project) => <ProjectCard project={project} />)}
    </div>
    <div class="mt-10 text-center">
      <a href="/projects/" class="btn-outline text-base">
        All projects
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>

  <!-- How we interact -->
  <section class="shell pt-20 md:pt-28">
    <SectionHeading eyebrow="Engagement models" title="How we interact" />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {interactionModes.map((m) => <InteractionCard {...m} />)}
    </div>
  </section>

  <section class="shell pt-20 md:pt-28">
    <CtaBand />
  </section>

  <SwagSection />
</MarketingLayout>

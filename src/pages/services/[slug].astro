---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import FeatureIcon from "../../components/FeatureIcon.astro";
import Icon from "../../components/Icon.astro";
import FaqList from "../../components/FaqList.astro";
import OfferCard from "../../components/OfferCard.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { services } from "../../data/services";
import { offersForService } from "../../data/offers";
import { projectsForService } from "../../data/projects";
import { site } from "../../data/site";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: {
      service,
      others: services.filter((s) => s.slug !== service.slug).slice(0, 3),
    },
  }));
}

const { service, others } = Astro.props;
const serviceOffers = offersForService(service.slug);
const relatedProjects = projectsForService(service.slug);
const pageUrl = new URL(`/services/${service.slug}/`, site.url).href;

// Service + FAQPage + breadcrumbs. FAQPage is what earns the expandable
// question snippets in Google results.
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: service.seoTitle,
    description: service.seoDescription,
    serviceType: service.title,
    url: pageUrl,
    provider: { "@id": `${site.url}/#organization` },
    areaServed: [
      { "@type": "Country", name: "Canada" },
      { "@type": "Country", name: "United States" },
    ],
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: `${service.title} capabilities`,
      itemListElement: service.capabilities.map((c) => ({
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: c },
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: service.faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      { "@type": "ListItem", position: 2, name: "Services", item: `${site.url}/services/` },
      { "@type": "ListItem", position: 3, name: service.title, item: pageUrl },
    ],
  },
];
---

<MarketingLayout
  title={service.seoTitle}
  description={service.seoDescription}
  schema={schema}
>
  <!-- Hero -->
  <section class="bg-paper">
    <div class="shell max-w-3xl pt-32 pb-12 md:pt-40 md:pb-16">
      <div class="reveal">
        <a
          href="/services/"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-periwinkle hover:text-navy"
        >
          <span class="rotate-180"><Icon name="arrow-right" size={16} /></span>
          All services
        </a>
        <div class="mt-6">
          <span
            class="inline-flex h-14 w-14 items-center justify-center rounded-xl bg-brand text-white"
          >
            <FeatureIcon name={service.icon} size={30} />
          </span>
        </div>
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-navy sm:text-5xl">
          {service.seoTitle}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">{service.tagline}</p>
        <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
          <a href="/contact/" class="btn-primary text-base">
            Start a conversation
            <Icon name="arrow-right" size={18} />
          </a>
          <a href={`mailto:${site.email}`} class="btn-outline text-base">Email us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="shell pt-12 md:pt-16">
    <div class="mx-auto max-w-3xl border-t border-line pt-12">
      <span class="eyebrow">Overview</span>
      <div class="mt-4 space-y-5 text-lg leading-relaxed text-ink-soft">
        {service.overview.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Capabilities + deliverables -->
  <section class="shell pt-16 md:pt-20">
    <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold text-navy">What we do</h2>
        <ul class="mt-5 space-y-3">
          {
            service.capabilities.map((c) => (
              <li class="flex gap-3 text-[1.02rem] leading-relaxed text-ink/85">
                <span class="mt-0.5 shrink-0 text-periwinkle">
                  <Icon name="check" size={20} />
                </span>
                {c}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-navy">What you get</h2>
        <ul class="mt-5 space-y-3">
          {
            service.deliverables.map((d) => (
              <li class="card flex items-start gap-3 p-4 text-[0.975rem] text-ink/85">
                <span class="mt-0.5 shrink-0 text-accent">
                  <Icon name="check" size={20} />
                </span>
                {d}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="shell pt-16 md:pt-20">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-2xl font-bold text-navy">How we work</h2>
      <ol class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          service.process.map((step, i) => (
            <li class="card p-6">
              <span class="text-sm font-extrabold tracking-widest text-accent">
                0{i + 1}
              </span>
              <h3 class="mt-2 text-lg font-bold text-navy">{step.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">
                {step.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Fixed-scope offer -->
  {
    serviceOffers.length > 0 && (
      <section class="shell pt-16 md:pt-20">
        <div class="mx-auto max-w-5xl">
          <h2 class="text-2xl font-bold text-navy">A low-risk way to start</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">
            Short, fixed scope, clear deliverable. You get a plan you can act on —
            with us or without us.
          </p>
          <div
            class:list={[
              "mt-6 grid gap-6",
              serviceOffers.length > 1 ? "md:grid-cols-2" : "max-w-xl",
            ]}
          >
            {serviceOffers.map((offer) => (
              <OfferCard offer={offer} showServiceLink={false} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Proof -->
  {
    relatedProjects.length > 0 && (
      <section class="shell pt-16 md:pt-20">
        <div class="mx-auto max-w-5xl">
          <h2 class="text-2xl font-bold text-navy">Related work</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">
            Platforms we have built in this space, with the team setup and the
            architecture behind each one.
          </p>
          <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {relatedProjects.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="shell pt-16 md:pt-20">
    <div class="mx-auto max-w-3xl">
      <FaqList faqs={service.faqs} />
    </div>
  </section>

  <!-- CTA band -->
  <section class="shell pt-16 md:pt-20">
    <CtaBand title={`Ready to talk about ${service.title}?`} />
  </section>

  <!-- Other services -->
  <section class="shell pt-16 md:pt-20">
    <h2 class="text-xl font-bold text-navy">Other services</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-3">
      {
        others.map((o) => (
          <a
            href={`/services/${o.slug}/`}
            class="card group flex items-center gap-4 p-5 transition-shadow hover:shadow-lift"
          >
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-fog text-navy transition-colors group-hover:bg-brand group-hover:text-white">
              <FeatureIcon name={o.icon} size={22} />
            </span>
            <span class="font-semibold text-navy group-hover:text-periwinkle">
              {o.title}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</MarketingLayout>

---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { caseStudies, PUBLISH_CASE_STUDIES } from "../../data/caseStudies";

// The page only builds once real case studies are approved. Until then it does
// not exist — no 404-in-sitemap, no thin page for Google to index.
export function getStaticPaths() {
  // A rest param with no value resolves to /case-studies/ itself.
  return PUBLISH_CASE_STUDIES ? [{ params: { page: undefined } }] : [];
}
---

<MarketingLayout
  title="Case Studies"
  description="Real data engineering engagements: Databricks lakehouses, Snowflake cost optimization, and AI data platforms — the problem, the work, and the measured result."
>
  <section class="shell pt-32 pb-12 text-center md:pt-40">
    <span class="eyebrow">Proof</span>
    <h1 class="mx-auto mt-3 max-w-3xl text-4xl font-extrabold tracking-tight text-navy sm:text-5xl">
      Case studies
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      What clients came to us with, what we built, and what changed afterwards.
    </p>
  </section>

  <section class="shell pb-20 md:pb-28">
    <div class="grid gap-6 md:grid-cols-2">
      {caseStudies.map((study) => <CaseStudyCard study={study} />)}
    </div>
    <div class="mt-14">
      <CtaBand title="Want a result like this?" />
    </div>
  </section>
</MarketingLayout>

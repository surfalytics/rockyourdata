---
import { getCollection } from "astro:content";
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Dates are authored as plain YYYY-MM-DD (UTC midnight), so format in UTC or
// they render a day early west of Greenwich.
const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-US", {
    dateStyle: "medium",
    timeZone: "UTC",
  }).format(d);
---

<MarketingLayout
  title="Blog"
  description="Practical writing on Databricks, Snowflake, AI data engineering, and building data platforms that hold up in production."
>
  <section class="shell pt-32 pb-10 md:pt-40">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <span class="eyebrow">Insights</span>
        <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-navy md:text-5xl">
          From the Blog
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">
          What we have learned building and tuning data platforms — written for
          the engineers and leads who have to run them.
        </p>
      </div>
      <a
        href={`https://${site.substackUrl}/subscribe`}
        target="_blank"
        rel="noopener"
        class="btn-outline shrink-0"
      >
        Subscribe
        <Icon name="arrow-up-right" size={18} />
      </a>
    </div>
  </section>

  <section class="shell pb-20 md:pb-28">
    {
      posts.length === 0 ? (
        <p class="text-ink-soft">No posts yet.</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}/`}
              class="card group flex flex-col p-6 transition-shadow hover:shadow-lift"
            >
              <div class="flex flex-wrap items-center gap-3">
                <span class="rounded-pill bg-fog px-3 py-1 text-xs font-semibold text-periwinkle-200">
                  {post.data.category}
                </span>
                <time class="text-xs font-semibold uppercase tracking-widest text-lilac">
                  {fmt(post.data.date)}
                </time>
              </div>
              <h2 class="mt-3 text-lg font-bold leading-snug text-navy group-hover:text-periwinkle">
                {post.data.title}
              </h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">
                {post.data.description}
              </p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-periwinkle">
                Read article
                <Icon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      )
    }

    <div class="mt-16">
      <CtaBand />
    </div>
  </section>
</MarketingLayout>

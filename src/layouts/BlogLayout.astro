---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import type { Offering } from "../data/offerings";

interface Props {
  title: string;
  description?: string;
  author?: string;
  date?: Date;
  category?: string;
  prev?: { href: string; title: string } | null;
  next?: { href: string; title: string } | null;
  /** The service or practice this post supports. Shown as a card at the end. */
  related?: Offering;
  schema?: Record<string, unknown>[];
}

const { title, description, author, date, category, prev, next, related, schema } =
  Astro.props;
const dateStr = date
  ? new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(date)
  : null;
---

<BaseLayout title={title} description={description} schema={schema} ogType="article">
  <Header />
  <main>
    <article class="shell max-w-3xl pt-14 md:pt-20">
      <header class="mb-10 border-b border-line pb-8">
        <a href="/blog/" class="eyebrow -my-2 py-2 no-underline hover:opacity-80">
          {category ?? "Blog"}
        </a>
        <h1 class="mt-4 text-4xl font-extrabold leading-tight text-navy md:text-5xl">
          {title}
        </h1>
        <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-lilac">
          {author && <span class="font-semibold text-navy">{author}</span>}
          {author && dateStr && <span aria-hidden="true">·</span>}
          {dateStr && <time datetime={date?.toISOString().slice(0, 10)}>{dateStr}</time>}
        </p>
      </header>

      <div class="prose">
        <slot />
      </div>

      {
        related && (
          <a
            href={related.href}
            class="card card-link group mt-14 flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between md:p-7"
          >
            <span>
              <span class="eyebrow">{related.label}</span>
              <span class="mt-2 block font-display text-xl font-bold text-navy group-hover:text-periwinkle">
                {related.title}
              </span>
              <span class="mt-1 block leading-relaxed text-ink-soft">{related.tagline}</span>
            </span>
            <span class="inline-flex shrink-0 items-center gap-2 font-semibold text-periwinkle">
              {related.linkLabel}
              <Icon name="arrow-right" size={18} />
            </span>
          </a>
        )
      }

      {
        (prev || next) && (
          <nav
            class:list={[
              "grid gap-4 border-t border-line pt-8 sm:grid-cols-2",
              related ? "mt-10" : "mt-16",
            ]}
            aria-label="More posts"
          >
            {prev ? (
              <a href={prev.href} class="card card-link group p-5">
                <span class="label text-lilac">Previous</span>
                <span class="mt-1 block font-semibold text-navy group-hover:text-periwinkle">
                  {prev.title}
                </span>
              </a>
            ) : (
              <span class="hidden sm:block" />
            )}
            {next && (
              <a href={next.href} class="card card-link group p-5 sm:text-right">
                <span class="label text-lilac">Next</span>
                <span class="mt-1 block font-semibold text-navy group-hover:text-periwinkle">
                  {next.title}
                </span>
              </a>
            )}
          </nav>
        )
      }
    </article>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .prose {
    color: var(--color-ink);
    font-size: 1.075rem;
    line-height: 1.75;
  }
  .prose > * + * {
    margin-top: 1.25em;
  }
  .prose h2 {
    margin-top: 2em;
    margin-bottom: 0.6em;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .prose h3 {
    margin-top: 1.6em;
    margin-bottom: 0.5em;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .prose strong {
    color: var(--color-navy);
    font-weight: 700;
  }
  .prose a {
    color: var(--color-periwinkle);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose a:hover {
    color: var(--color-navy);
  }
  .prose ul {
    list-style: disc;
    padding-left: 1.4em;
  }
  .prose ol {
    list-style: decimal;
    padding-left: 1.4em;
  }
  .prose li {
    margin-top: 0.4em;
  }
  .prose li::marker {
    color: var(--color-lilac);
  }
  .prose hr {
    margin-block: 2.5em;
    border: 0;
    border-top: 1px solid var(--color-line);
  }
  .prose img {
    border-radius: var(--radius-card);
    display: inline-block;
  }
  .prose code {
    background: var(--color-fog);
    padding: 0.15em 0.4em;
    border-radius: 6px;
    font-size: 0.9em;
  }
  /* Shiki sets its own background inline, so this needs !important to keep
     code blocks on the navy palette. */
  .prose pre {
    background: #060912 !important;
    color: #e7e9f5;
    border: 1px solid var(--color-line);
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-card);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.65;
  }
  .prose pre code {
    background: transparent;
    padding: 0;
    font-size: inherit;
  }
  .prose blockquote {
    border-left: 3px solid var(--color-periwinkle);
    padding-left: 1.1rem;
    color: var(--color-ink-soft);
    font-style: italic;
  }

  /* Tables. Full width on larger screens. On phones `display: block` lets a
     wide table scroll inside its own box instead of pushing the page
     sideways. */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  @media (max-width: 639px) {
    .prose table {
      display: block;
      overflow-x: auto;
    }
  }
  .prose th,
  .prose td {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
  }
  .prose th {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-lilac);
    white-space: nowrap;
    border-bottom-color: var(--color-periwinkle);
  }
  .prose td:first-child {
    color: var(--color-navy);
    font-weight: 600;
  }
  .prose tbody tr:last-child td {
    border-bottom: 0;
  }

  /* Diagrams (SVG images in a post). The labels inside are 12px at full
     size, so the image must never be scaled far below its 960px width. */
  .prose p:has(> img[src$=".svg"]) {
    overflow-x: auto;
  }
  .prose p > img[src$=".svg"] {
    display: block;
    width: 100%;
    max-width: none;
    min-width: 54rem;
    height: auto;
  }
  /* Phones and tablets: the diagram scrolls sideways, with a hint that
     stays in view while it scrolls. */
  .prose p:has(> img[src$=".svg"])::after {
    content: "Swipe sideways to see the full diagram.";
    position: sticky;
    left: 0;
    display: block;
    width: max-content;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-lilac);
  }
  /* Desktop: the diagram breaks out of the text column instead. */
  @media (min-width: 1024px) {
    .prose p:has(> img[src$=".svg"]) {
      margin-inline: -8rem;
      overflow-x: visible;
    }
    .prose p > img[src$=".svg"] {
      min-width: 0;
    }
    .prose p:has(> img[src$=".svg"])::after {
      content: none;
    }
  }
</style>

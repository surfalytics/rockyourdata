---
import Icon from "./Icon.astro";
import type { CaseStudy } from "../data/caseStudies";

interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;
---

<article class="card flex flex-col p-7 md:p-8">
  <span class="eyebrow">{study.industry}</span>
  <h3 class="mt-3 text-xl font-bold text-navy md:text-2xl">{study.title}</h3>
  <p class="mt-1 text-sm text-lilac">{study.client}</p>

  {
    study.metrics.length > 0 && (
      <dl class="mt-6 grid grid-cols-2 gap-4 border-y border-line py-5">
        {study.metrics.map((m) => (
          <div>
            <dt class="sr-only">{m.label}</dt>
            <dd>
              <span class="block text-3xl font-extrabold tracking-tight text-accent">
                {m.value}
              </span>
              <span class="mt-1 block text-sm leading-snug text-ink-soft">
                {m.label}
              </span>
            </dd>
          </div>
        ))}
      </dl>
    )
  }

  <div class="mt-6 space-y-4 text-[0.975rem] leading-relaxed text-ink-soft">
    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wide text-navy">Challenge</h4>
      <p class="mt-1.5">{study.challenge}</p>
    </div>
    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wide text-navy">What we did</h4>
      <ul class="mt-1.5 space-y-2">
        {
          study.approach.map((a) => (
            <li class="flex gap-3">
              <span class="mt-0.5 shrink-0 text-periwinkle">
                <Icon name="check" size={18} />
              </span>
              {a}
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wide text-navy">Outcome</h4>
      <p class="mt-1.5">{study.outcome}</p>
    </div>
  </div>

  <a
    href={`/services/${study.service}/`}
    class="mt-6 inline-flex items-center gap-2 font-semibold text-periwinkle hover:text-navy"
  >
    Related service
    <Icon name="arrow-right" size={18} />
  </a>
</article>

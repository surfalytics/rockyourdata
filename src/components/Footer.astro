---
import { Image } from "astro:assets";
import logo from "../assets/logo/rockyourdata-logo.png";
import { nav, site } from "../data/site";
import { services } from "../data/services";
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();
const explore = [...nav, { label: "Contact", href: "/contact/" }];
// `inline-block py-1.5` gives every link a 32px tap target without adding
// visual space between the rows.
const linkClass = "inline-block py-1.5 transition-colors hover:text-white";
---

<footer class="mt-24 bg-brand text-white">
  <div class="shell py-12 md:py-16">
    <!-- Phones: brand on top, then the two link lists side by side. -->
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:gap-x-12 lg:grid-cols-[1.8fr_1fr_1.2fr]">
      <!-- Brand -->
      <div class="col-span-2 lg:col-span-1">
        <Image
          src={logo}
          alt="Rock Your Data"
          height={40}
          densities={[1, 2]}
          class="h-10 w-auto brightness-0 invert"
        />
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/70">
          {site.description}
        </p>
        <a
          href={`mailto:${site.email}`}
          class="mt-4 inline-block py-1 text-sm font-medium text-white/90 transition-colors hover:text-white"
        >
          {site.email}
        </a>
        <SocialLinks tone="light" class="mt-4" />
      </div>

      <!-- Nav -->
      <nav aria-label="Footer">
        <h2 class="label text-periwinkle-200">Explore</h2>
        <ul class="mt-3 text-sm text-white/80">
          {
            explore.map((item) => (
              <li>
                <a href={item.href} class={linkClass}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Services -->
      <nav aria-label="Services">
        <h2 class="label text-periwinkle-200">Services</h2>
        <ul class="mt-3 text-sm text-white/80">
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.slug}/`} class={linkClass}>
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 border-t border-white/15 pt-6 text-sm text-white/60 md:mt-14"
    >
      <p>&copy; {year} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>

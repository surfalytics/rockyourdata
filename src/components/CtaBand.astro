---
import Icon from "./Icon.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  body?: string;
  class?: string;
}
const {
  title = "Let's talk about your data platform",
  body = "Tell us what you are working on. We reply within one business day, and we will tell you plainly if we are not the right fit.",
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "rounded-[1.5rem] bg-brand px-7 py-12 text-center text-white md:px-14 md:py-14",
    className,
  ]}
>
  <h2 class="mx-auto max-w-2xl text-2xl font-extrabold leading-snug md:text-3xl">
    {title}
  </h2>
  <p class="mx-auto mt-4 max-w-xl leading-relaxed text-white/75">{body}</p>
  <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
    <a href="/contact/" class="btn-accent text-base">
      Start a conversation
      <Icon name="arrow-right" size={18} />
    </a>
    <a
      href={`mailto:${site.email}`}
      class="btn-outline border-white/40 bg-white/10 text-base text-white hover:bg-white hover:text-paper"
    >
      Email us
    </a>
  </div>
</div>
